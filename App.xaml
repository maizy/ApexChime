<Application x:Class="ApexChime.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="Background" Color="#141718" />
    <SolidColorBrush x:Key="Surface" Color="#1C2022" />
    <SolidColorBrush x:Key="Control" Color="#272D30" />
    <SolidColorBrush x:Key="Stroke" Color="#353D40" />
    <SolidColorBrush x:Key="Text" Color="#F2F4F2" />
    <SolidColorBrush x:Key="Muted" Color="#AAB6B7" />
    <SolidColorBrush x:Key="Accent" Color="#DBF784" />
    <SolidColorBrush x:Key="Error" Color="#FFACA4" />
    <Geometry x:Key="Hourglass">M5,3 H19 M5,21 H19 M7,3 V6 Q7,9 12,12 Q17,15 17,18 V21 M17,3 V6 Q17,9 12,12 Q7,15 7,18 V21 M8,19 H16</Geometry>
    <Geometry x:Key="Finger">M8,12 V5 A2,2 0 0 1 12,5 V11 H16 Q19,11 19,14 V16 Q19,21 15,21 H12 Q9,21 7,18 L5,15 Q4,13 6,12 Q7,12 8,14 M7,8 H13 M10,8 C5,9 4,6 6,6 Q8,6 10,8 C11,5 15,5 14,7 Q13,9 10,8 L14,11</Geometry>
    <Geometry x:Key="Power">M12,3 V11 M7,6 A8,8 0 1 0 17,6</Geometry>
    <Geometry x:Key="Bell">M4,17 H20 L18,14 V10 A6,6 0 0 0 6,10 V14 Z M10,20 Q12,23 14,20</Geometry>
    <Geometry x:Key="Trash">M4,6 H20 M9,6 V3 H15 V6 M6,6 L7,21 H17 L18,6 M10,10 V17 M14,10 V17</Geometry>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="17" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}" />
      <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="15" />
    </Style>
    <Style x:Key="ButtonFrame" TargetType="ButtonBase">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Background" Value="{StaticResource Control}" />
      <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ButtonBase">
            <Border x:Name="Frame" CornerRadius="7" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Frame" Property="Opacity" Value=".72" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource ButtonFrame}" />
    <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource ButtonFrame}">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="BorderBrush" Value="#899F57" />
      <Setter Property="Foreground" Value="#1C2410" />
      <Setter Property="MinWidth" Value="70" />
    </Style>
    <Style TargetType="ToggleButton" BasedOn="{StaticResource ButtonFrame}">
      <Setter Property="Padding" Value="8,5" />
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="BorderBrush" Value="#81964C" />
          <Setter Property="Foreground" Value="{StaticResource Accent}" />
          <Setter Property="Background" Value="#2C3521" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Background}" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="CaretBrush" Value="{StaticResource Text}" />
      <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="MinHeight" Value="35" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Frame" CornerRadius="7" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
              <ScrollViewer x:Name="PART_ContentHost" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            Focusable="False" ClickMode="Press">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Frame" Background="{StaticResource Control}" BorderBrush="{StaticResource Stroke}"
                            CornerRadius="7" BorderThickness="1" />
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}" />
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Border x:Name="FocusRing" BorderBrush="Transparent" BorderThickness="2" CornerRadius="7" IsHitTestVisible="False" />
              <ContentPresenter Margin="9,0,25,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
              <Path Data="M0,0 L4,4 L8,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,9,0" Stroke="{StaticResource Muted}" StrokeThickness="1.5" IsHitTestVisible="False" />
              <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                     AllowsTransparency="True" Focusable="False">
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                        CornerRadius="7" Padding="3" MinWidth="{TemplateBinding ActualWidth}">
                  <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True">
                    <ItemsPresenter />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Padding" Value="7,5" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Option" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Option" Property="Background" Value="#2C3521" />
              </Trigger>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Option" Property="Background" Value="{StaticResource Control}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <ControlTemplate x:Key="ScrollPage" TargetType="RepeatButton">
      <Border Background="Transparent" />
    </ControlTemplate>
    <Style x:Key="ScheduleScrollBar" TargetType="ScrollBar">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Template="{StaticResource ScrollPage}" Focusable="False" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="Grip" Background="#526064" Margin="3,0,0,0" CornerRadius="3" />
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Grip" Property="Background" Value="{StaticResource Muted}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Template="{StaticResource ScrollPage}" Focusable="False" />
              </Track.IncreaseRepeatButton>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
