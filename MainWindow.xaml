<Window x:Class="ApexChime.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ApexChime" Width="642" Height="820" MinWidth="550" MinHeight="670"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Background}"
        Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" Icon="Assets/ApexChime.ico">
  <Grid Margin="24,18,24,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,17">
      <Image Width="46" Height="46" Source="Assets/ApexChime.png" Margin="0,0,12,0" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="ApexChime" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="Timers and reminders for sim racing" Foreground="{StaticResource Muted}" />
      </StackPanel>
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="Timers" Style="{StaticResource SectionTitle}" Margin="0,0,0,9" />
        <UniformGrid x:Name="PresetButtons" Rows="2" Columns="5" Margin="0,0,-6,9" />
        <Label Target="{Binding ElementName=TimerInput}" Content="Custom duration" Padding="0,0,0,4"
               Foreground="{StaticResource Muted}" />
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="_Run" Style="{StaticResource Action}" Margin="7,0,0,0" Click="RunTimer" />
          <TextBox x:Name="TimerInput" KeyDown="TimerInputKeyDown" />
        </DockPanel>
        <TextBlock Text="15 for minutes  ·  5:23 for hours and minutes  ·  !14:00 for a finish time"
                   Margin="0,6,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
        <TextBlock Text="Add a space and a description, e.g. 15 Check fuel."
                   Margin="0,2,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="Daily reminders" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="77" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,7,0">
            <Label Target="{Binding ElementName=ReminderTime}" Content="Time (HH:MM)" Padding="0,0,0,4"
                   Foreground="{StaticResource Muted}" />
            <TextBox x:Name="ReminderTime" KeyDown="ReminderInputKeyDown" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <Label Target="{Binding ElementName=ReminderText}" Content="Message (optional)" Padding="0,0,0,4"
                   Foreground="{StaticResource Muted}" />
            <TextBox x:Name="ReminderText" MaxLength="30" KeyDown="ReminderInputKeyDown" />
          </StackPanel>
          <Button Grid.Column="2" Content="_Add" Style="{StaticResource Action}" Margin="7,0,0,0" Height="35"
                  VerticalAlignment="Bottom" Click="AddReminder" />
        </Grid>
      </StackPanel>
    </Border>
    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="15,13,15,7">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Schedule" Style="{StaticResource SectionTitle}" Margin="0,0,0,9" />
        <Grid Grid.Row="1" Margin="0,0,19,3">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" /><ColumnDefinition Width="86" /><ColumnDefinition Width="70" /><ColumnDefinition Width="35" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="1" Text="Remaining" Foreground="{StaticResource Muted}" />
          <TextBlock Grid.Column="2" Text="Due" Foreground="{StaticResource Muted}" />
        </Grid>
        <ListBox Grid.Row="2" x:Name="ScheduleList" Background="Transparent" BorderThickness="0" Padding="0"
                 ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Visible" AutomationProperties.Name="Schedule">
          <ListBox.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource ScheduleScrollBar}" />
          </ListBox.Resources>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" Background="Transparent" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="{StaticResource Control}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid MinHeight="42" Margin="0,0,2,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="86" /><ColumnDefinition Width="70" /><ColumnDefinition Width="35" />
                </Grid.ColumnDefinitions>
                <DockPanel Margin="0,0,6,0">
                  <Viewbox Width="17" Height="18" Margin="0,0,8,0">
                    <Canvas Width="24" Height="24">
                      <Path StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                        <Path.Style>
                          <Style TargetType="Path">
                            <Setter Property="Data" Value="{StaticResource Hourglass}" />
                            <Setter Property="Stroke" Value="{StaticResource Accent}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsReminder}" Value="True">
                                <Setter Property="Data" Value="{StaticResource Finger}" />
                                <Setter Property="Stroke" Value="#A7CBF2" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Path.Style>
                      </Path>
                    </Canvas>
                  </Viewbox>
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"
                             FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Grid.Column="1" Text="{Binding Remaining}" FontFamily="Consolas" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Due}" FontFamily="Consolas"
                           Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                <Button Grid.Column="3" Width="30" Height="30" MinHeight="0" Padding="0"
                        Background="Transparent" BorderBrush="Transparent" Tag="{Binding Id}"
                        ToolTip="{Binding RemoveLabel}" AutomationProperties.Name="{Binding RemoveLabel}" Click="RemoveItem">
                  <Path Data="{StaticResource Trash}" Stroke="{StaticResource Muted}" StrokeThickness="1.6"
                        Width="15" Height="15" Stretch="Uniform" StrokeLineJoin="Round" />
                </Button>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="2" x:Name="EmptySchedule" Text="No timers or reminders scheduled."
                   Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center"
                   IsHitTestVisible="False" />
      </Grid>
    </Border>
    <TextBlock Grid.Row="4" x:Name="Status" Foreground="{StaticResource Error}" TextWrapping="Wrap"
               Visibility="Collapsed" Margin="0,7,0,0" AutomationProperties.LiveSetting="Polite" />
    <DockPanel Grid.Row="5" Margin="0,12,0,0" LastChildFill="False">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
        <ToggleButton x:Name="StartupToggle" Click="ToggleStartup" AutomationProperties.Name="Start with Windows" ToolTip="Start with Windows">
          <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource Power}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                  StrokeThickness="1.8" Width="15" Height="15" Stretch="Uniform" Margin="0,0,5,0" />
            <TextBlock Text="Autostart" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
          </StackPanel>
        </ToggleButton>
        <ToggleButton x:Name="NotificationsToggle" Margin="6,0,13,0" Click="ToggleNotifications"
                      AutomationProperties.Name="Notifications" ToolTip="Timer and reminder notifications">
          <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource Bell}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                  StrokeThickness="1.8" Width="15" Height="15" Stretch="Uniform" Margin="0,0,5,0" />
            <TextBlock Text="Notifications" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
          </StackPanel>
        </ToggleButton>
        <Label Content="Sound" Target="{Binding ElementName=SoundSelector}" Foreground="{StaticResource Muted}"
               VerticalAlignment="Center" Padding="0,0,6,0" />
        <ComboBox x:Name="SoundSelector" Width="144" Height="34" VerticalAlignment="Center"
                  VerticalContentAlignment="Center" SelectionChanged="ChangeSound" DisplayMemberPath="Label" />
      </StackPanel>
      <TextBlock x:Name="VersionText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
    </DockPanel>
  </Grid>
</Window>
